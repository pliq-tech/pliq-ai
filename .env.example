# gRPC Server
GRPC_HOST=0.0.0.0
GRPC_PORT=50051
MAX_WORKERS=10

# Google AI
GOOGLE_API_KEY=your-google-api-key
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_LOCATION=us-central1

# Model Selection
GEMINI_PRO_MODEL=gemini-2.5-pro-preview-05-06
GEMINI_FLASH_MODEL=gemini-2.5-flash-preview-05-20
EMBEDDING_MODEL=text-embedding-005

# Fraud Detection Thresholds
FRAUD_DETECTION_THRESHOLD=0.7
FRAUD_ELA_WEIGHT=0.35
FRAUD_FFT_WEIGHT=0.25
FRAUD_EXIF_WEIGHT=0.20
FRAUD_REVERSE_WEIGHT=0.20
PRICE_ANOMALY_Z_THRESHOLD=2.0
DUPLICATION_TEXT_THRESHOLD=0.85
DUPLICATION_PHASH_THRESHOLD=10

# Matching Weights
COMMUTE_WEIGHT=0.25
NOISE_WEIGHT=0.15
AMENITY_WEIGHT=0.15
SOCIAL_WEIGHT=0.10
BUDGET_WEIGHT=0.25
PET_WEIGHT=0.10

# Logging
LOG_LEVEL=info
